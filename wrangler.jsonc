{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "family-kit",
	"compatibility_date": "2026-08-28",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "./worker/index.ts",
	"assets": {
		"not_found_handling": "single-page-application",
		"binding": "ASSETS",
		"run_worker_first": [
			"/api/*"
		]
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"logs": {
			"invocation_logs": true,
			"head_sampling_rate": 1
		}
	},
	"vars": {
		"SIGNUPS_OPEN": "dogfood",
		"MAILER": "resend",
		// Dummy always-pass Turnstile sitekey (Cloudflare test widget: 1x00000000000000000000AA).
		// NOT a production widget key. Production: create a Turnstile widget, set this var to the
		// real sitekey, and `npx wrangler secret put TURNSTILE_SECRET_KEY`.
		"TURNSTILE_SITE_KEY": "1x00000000000000000000AA"
		// DOFOOD_EMAIL is a PR-7 ops fill-in; do not invent the mailbox here.
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "family-kit",
			"database_id": "9cb8c98f-27d2-4734-95c0-d21edf2f072f",
			"remote": true
		}
	]
}